<Page
    x:Class="ImageCleanup.App.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ImageCleanup.App.ViewModels">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- ── Results list ────────────────────────────────────────────────── -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,4,4,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:DuplicateGroupViewModel">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                            <TextBlock Text="{x:Bind Header, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Content="View Group"
                                    Click="OnViewGroupClick"
                                    Tag="{x:Bind}"
                                    FontSize="11"
                                    Padding="8,3"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind FileActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:FileActionViewModel">
                                    <Grid ColumnDefinitions="72,*,140,Auto"
                                          Margin="16,2,0,2">
                                        <!-- Thumbnail preview -->
                                        <Image Grid.Column="0"
                                               Source="{x:Bind Thumbnail, Mode=OneWay}"
                                               Width="64" Height="64"
                                               Stretch="Uniform"
                                               Margin="0,0,8,0"/>
                                        <!-- File path -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind FilePath}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Opacity="0.85"/>
                                        <!-- Action picker — "Keep" is a real selectable action; the star
                                             just indicates whichever file currently holds it. The star sits
                                             in its own fixed-width column so the ComboBox's left edge lines
                                             up across rows whether or not a given row's star is visible. -->
                                        <Grid Grid.Column="2"
                                              ColumnDefinitions="16,*"
                                              Margin="8,0"
                                              VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0"
                                                       Text="★"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{x:Bind SuggestedBadgeVisibility, Mode=OneWay}"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{x:Bind AvailableActions}"
                                                      SelectedItem="{x:Bind SelectedAction, Mode=TwoWay}"
                                                      FontSize="12"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- Move target path (only visible when Move selected) -->
                                        <TextBox Grid.Column="3"
                                                 Width="220"
                                                 PlaceholderText="Destination path…"
                                                 Text="{x:Bind TargetPath, Mode=TwoWay}"
                                                 Visibility="{x:Bind MoveTargetVisibility, Mode=OneWay}"
                                                 FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ── Staging review panel ────────────────────────────────────────── -->
        <Border Grid.Row="2"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0"
                Margin="0,8,0,0"
                Visibility="{x:Bind ViewModel.StagingPanelVisibility, Mode=OneWay}">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.StagedCountText, Mode=OneWay}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="Commit Changes"
                            Click="OnCommitClick"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
                <ListView MaxHeight="180"
                          ItemsSource="{x:Bind ViewModel.StagedItems, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StagingEntryViewModel">
                            <Grid ColumnDefinitions="48,*,80,Auto" VerticalAlignment="Center">
                                <Image Grid.Column="0"
                                       Source="{x:Bind Thumbnail, Mode=OneWay}"
                                       Width="40" Height="40"
                                       Stretch="Uniform"
                                       Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind DisplayText}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Action}"
                                           Margin="8,0"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <Button Grid.Column="3"
                                        Content="Remove"
                                        Tag="{x:Bind StagingId}"
                                        Click="OnRemoveStagingClick"
                                        FontSize="11"
                                        Padding="8,3"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

    </Grid>
</Page>
