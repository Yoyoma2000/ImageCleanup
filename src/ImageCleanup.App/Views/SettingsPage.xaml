<Page
    x:Class="ImageCleanup.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ImageCleanup.App.Localization">

    <StackPanel Padding="16" Spacing="24" MaxWidth="480" HorizontalAlignment="Left">

        <StackPanel Spacing="8">
            <TextBlock Text="{loc:Loc Key=Settings.AppearanceHeader}" FontWeight="SemiBold" FontSize="16"/>
            <!--
                RadioButton children (not RadioButtons.Items with x:String) —
                markup-extension curly-brace syntax like {loc:Loc ...} only
                evaluates as an attribute value, not as plain x:String
                element content, so each option needs to be a real
                RadioButton with Content set as an attribute.
            -->
            <RadioButtons x:Name="ThemeRadioButtons"
                          SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                <RadioButton Content="{loc:Loc Key=Settings.Theme.System}"/>
                <RadioButton Content="{loc:Loc Key=Settings.Theme.Light}"/>
                <RadioButton Content="{loc:Loc Key=Settings.Theme.Dark}"/>
            </RadioButtons>
            <TextBlock Text="{loc:Loc Key=Settings.ThemeHint}"
                       Opacity="0.7" FontSize="12"/>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="{loc:Loc Key=Settings.LanguageHeader}" FontWeight="SemiBold" FontSize="16"/>
            <RadioButtons x:Name="LanguageRadioButtons"
                          SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                <RadioButton Content="{loc:Loc Key=Settings.Language.Dev}"/>
                <RadioButton Content="{loc:Loc Key=Settings.Language.English}"/>
                <RadioButton Content="{loc:Loc Key=Settings.Language.Chinese}"/>
            </RadioButtons>
            <TextBlock Text="{loc:Loc Key=Settings.LanguageHint}"
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="{loc:Loc Key=Settings.MaintenanceHeader}" FontWeight="SemiBold" FontSize="16"/>

            <StackPanel Spacing="4">
                <Button Content="{loc:Loc Key=Settings.ClearCacheButton}" Click="OnClearCacheClick" HorizontalAlignment="Left"/>
                <TextBlock Text="{loc:Loc Key=Settings.ClearCacheDescription}"
                           TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="4" Margin="0,12,0,0">
                <Button Content="{loc:Loc Key=Settings.ClearMoveHistoryButton}" Click="OnClearMoveHistoryClick" HorizontalAlignment="Left"/>
                <TextBlock Text="{loc:Loc Key=Settings.ClearMoveHistoryDescription}"
                           TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Opacity="0.85"/>

    </StackPanel>
</Page>
