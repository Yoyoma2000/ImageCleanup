<Page
    x:Class="ImageCleanup.App.Views.QualityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ImageCleanup.App.ViewModels">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- ── Blurriest-first review list ─────────────────────────────────── -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,2"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:FileActionViewModel">
                    <Grid ColumnDefinitions="72,*,80,140,Auto" Margin="0,2">
                        <!-- Thumbnail preview -->
                        <Image Grid.Column="0"
                               Source="{x:Bind Thumbnail, Mode=OneWay}"
                               Width="64" Height="64"
                               Stretch="Uniform"
                               Margin="0,0,8,0"/>
                        <!-- File path -->
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind FilePath}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Opacity="0.85"/>
                        <!-- BlurScore — lower is blurrier -->
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind BlurScoreDisplay}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="8,0"
                                   FontSize="12"
                                   Opacity="0.7"
                                   ToolTipService.ToolTip="BlurScore (Laplacian variance) — lower means blurrier"/>
                        <!--
                            Action picker: None/Keep/Delete/Move, default None.
                            Bound via SelectedIndex (not SelectedItem) — this
                            ListView virtualizes, and a SelectedItem-bound
                            ComboBox can show blank after a container is
                            reused for a different FileActionViewModel post
                            row-removal (e.g. after a delete shrinks the
                            list). SelectedIndex has no ItemsSource item to
                            re-match on reuse, so it isn't affected.
                        -->
                        <ComboBox Grid.Column="3"
                                  Margin="8,0"
                                  ItemsSource="{x:Bind AvailableActions}"
                                  SelectedIndex="{x:Bind SelectedActionIndex, Mode=TwoWay}"
                                  FontSize="12"
                                  HorizontalAlignment="Stretch"/>
                        <!-- Move target path (only visible when Move selected) -->
                        <TextBox Grid.Column="4"
                                 Width="220"
                                 PlaceholderText="Destination path…"
                                 Text="{x:Bind TargetPath, Mode=TwoWay}"
                                 Visibility="{x:Bind MoveTargetVisibility, Mode=OneWay}"
                                 FontSize="12"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            ── Staging review panel — independent from Duplicates' panel ────
            LayerFillColorDefaultBrush gives this panel a distinct surface
            from the plain page background above, same reasoning as
            DuplicatesPage's staging panel.
        -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Margin="0,8,0,0"
                Visibility="{x:Bind ViewModel.StagingPanelVisibility, Mode=OneWay}">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.StagedCountText, Mode=OneWay}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="Commit Changes"
                            Click="OnCommitClick"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
                <ListView MaxHeight="180"
                          ItemsSource="{x:Bind ViewModel.StagedItems, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StagingEntryViewModel">
                            <Grid ColumnDefinitions="48,*,80,Auto" VerticalAlignment="Center">
                                <Image Grid.Column="0"
                                       Source="{x:Bind Thumbnail, Mode=OneWay}"
                                       Width="40" Height="40"
                                       Stretch="Uniform"
                                       Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind DisplayText}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Action}"
                                           Margin="8,0"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <Button Grid.Column="3"
                                        Content="Remove"
                                        Tag="{x:Bind StagingId}"
                                        Click="OnRemoveStagingClick"
                                        FontSize="11"
                                        Padding="8,3"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

    </Grid>
</Page>
