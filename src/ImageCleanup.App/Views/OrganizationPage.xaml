<Page
    x:Class="ImageCleanup.App.Views.OrganizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ImageCleanup.App.ViewModels">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16">

        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- ── Destination + execute ───────────────────────────────────── -->
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Choose Destination…"
                        Click="OnSelectDestinationClick"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind ViewModel.DestinationFolder, Mode=OneWay}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.85"/>
            </StackPanel>
            <Button Content="Organize Files…"
                    Click="OnExecuteClick"
                    IsEnabled="{x:Bind ViewModel.CanExecutePlan, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Left"/>
        </StackPanel>

        <!--
            Thumbnails are NOT requested for every file when the plan builds
            (a real library can be thousands of files); OnTreeViewExpanding
            requests them only for a Category node's files once that node is
            actually expanded.
        -->
        <TreeView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}"
                  Expanding="OnTreeViewExpanding"
                  SelectionMode="None"
                  CanDragItems="False"
                  CanReorderItems="False">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:OrganizationNodeViewModel">
                    <TreeViewItem ItemsSource="{x:Bind Children}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                            <Image Grid.Column="0"
                                   Source="{x:Bind Thumbnail, Mode=OneWay}"
                                   Width="40" Height="40"
                                   Margin="0,0,8,0"
                                   Stretch="Uniform"
                                   Visibility="{x:Bind ThumbnailVisibility}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind DisplayText}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       FontSize="13"/>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind TargetFileName}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind TargetNameVisibility}"/>
                            <Border Grid.Column="3"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    Visibility="{x:Bind RenamedBadgeVisibility}">
                                <TextBlock Text="renamed"
                                           FontSize="11"
                                           Foreground="White"/>
                            </Border>
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</Page>
