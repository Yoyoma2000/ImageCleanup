<ContentDialog
    x:Class="ImageCleanup.App.Views.GroupDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ImageCleanup.App.ViewModels"
    Title="{x:Bind ViewModel.Header, Mode=OneWay}"
    CloseButtonText="Close"
    DefaultButton="Close">

    <!--
        GridView (not a plain ItemsControl) is required here: its default panel
        is a virtualizing ItemsWrapGrid, and virtualizing panels only get correct
        container recycling from a ListViewBase host. Hosting ItemsWrapGrid
        inside a plain ItemsControl let WinUI reuse containers without rebinding
        them, which was the cause of the ComboBox intermittently going missing
        for some files in larger (4+ file) groups.
    -->
    <GridView x:Name="FilesGridView"
              MaxWidth="1080"
              MaxHeight="640"
              SelectionMode="None"
              IsItemClickEnabled="False"
              ItemsSource="{x:Bind ViewModel.FileActions}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollMode="Disabled">
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:FileActionViewModel">
                <Border Width="340"
                        Margin="8"
                        Padding="8"
                        CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="{x:Bind KeepBorderThickness, Mode=OneWay}"
                        BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Image Source="{x:Bind DetailThumbnail, Mode=OneWay}"
                                   Width="320" Height="320"
                                   Stretch="Uniform"/>
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    Margin="6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Visibility="{x:Bind SuggestedBadgeVisibility, Mode=OneWay}">
                                <TextBlock Text="★ Keep"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{x:Bind FilePath}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Opacity="0.85"/>

                        <ComboBox ItemsSource="{x:Bind AvailableActions}"
                                  SelectedItem="{x:Bind SelectedAction, Mode=TwoWay}"
                                  FontSize="12"
                                  HorizontalAlignment="Stretch"/>

                        <TextBox PlaceholderText="Destination path…"
                                 Text="{x:Bind TargetPath, Mode=TwoWay}"
                                 FontSize="12"
                                 Visibility="{x:Bind MoveTargetVisibility, Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</ContentDialog>
