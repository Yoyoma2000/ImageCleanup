<Window
    x:Class="ImageCleanup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ImageCleanup.App.ViewModels"
    Title="ImageCleanup">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,0,0,8">
            <Button Content="Select Folder"
                    Click="OnSelectFolderClick"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"/>
        </StackPanel>

        <!-- ── Results list ────────────────────────────────────────────────── -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,4,4,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:DuplicateGroupViewModel">
                    <StackPanel>
                        <TextBlock Text="{x:Bind Header}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{x:Bind FileActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:FileActionViewModel">
                                    <Grid ColumnDefinitions="*,140,Auto"
                                          Margin="16,2,0,2">
                                        <!-- File path -->
                                        <TextBlock Text="{x:Bind FilePath}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Opacity="0.85"/>
                                        <!-- Suggested badge (replaces ComboBox for keep file) -->
                                        <TextBlock Grid.Column="1"
                                                   Text="★ Keep"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"
                                                   Visibility="{x:Bind SuggestedBadgeVisibility}"/>
                                        <!-- Action picker (non-suggested files) -->
                                        <ComboBox Grid.Column="1"
                                                  Margin="8,0"
                                                  ItemsSource="{x:Bind AvailableActions}"
                                                  SelectedItem="{x:Bind SelectedAction, Mode=TwoWay}"
                                                  FontSize="12"
                                                  Visibility="{x:Bind ActionComboVisibility}"/>
                                        <!-- Move target path (only visible when Move selected) -->
                                        <TextBox Grid.Column="2"
                                                 Width="220"
                                                 PlaceholderText="Destination path…"
                                                 Text="{x:Bind TargetPath, Mode=TwoWay}"
                                                 Visibility="{x:Bind MoveTargetVisibility, Mode=OneWay}"
                                                 FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ── Staging review panel ────────────────────────────────────────── -->
        <Border Grid.Row="2"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0"
                Margin="0,8,0,0"
                Visibility="{x:Bind ViewModel.StagingPanelVisibility, Mode=OneWay}">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.StagedCountText, Mode=OneWay}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="Commit Changes"
                            Click="OnCommitClick"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
                <ListView MaxHeight="180"
                          ItemsSource="{x:Bind ViewModel.StagedItems, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StagingEntryViewModel">
                            <Grid ColumnDefinitions="*,80,Auto" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayText}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Action}"
                                           Margin="8,0"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <Button Grid.Column="2"
                                        Content="Remove"
                                        Tag="{x:Bind StagingId}"
                                        Click="OnRemoveStagingClick"
                                        FontSize="11"
                                        Padding="8,3"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

    </Grid>
</Window>
