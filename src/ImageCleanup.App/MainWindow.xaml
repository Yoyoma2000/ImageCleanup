<Window
    x:Class="ImageCleanup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ImageCleanup.App.ViewModels"
    Title="ImageCleanup">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- ── Toolbar ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,0,0,8">
            <Button Content="Select Folder"
                    Click="OnSelectFolderClick"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"/>
        </StackPanel>

        <!-- ── Results list ───────────────────────────────────────────── -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,4,4,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:DuplicateGroupViewModel">
                    <StackPanel>
                        <!-- Keep suggestion -->
                        <TextBlock Text="{x:Bind Header}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <!-- Other (redundant) files -->
                        <ItemsControl ItemsSource="{x:Bind OtherFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               Margin="20,1,0,1"
                                               FontSize="12"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Window>
