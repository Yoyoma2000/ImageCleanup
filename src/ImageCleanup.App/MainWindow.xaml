<Window
    x:Class="ImageCleanup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ImageCleanup">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Folder selection — shared across every page ────────────────── -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Padding="16,16,16,8">
            <Button Content="Select Folder"
                    Click="OnSelectFolderClick"
                    IsEnabled="{x:Bind ScanSession.IsIdle, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ScanSession.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"/>
        </StackPanel>

        <!--
            LeftCompact (not the previous "Left") is what gives the hamburger
            toggle its collapse/expand behavior: collapsed shows a slim
            icon-only pane (CompactPaneLength, ~48px — too narrow for label
            text, which is why "Left" was clipping labels instead of hiding
            them), toggled-open shows the full icon+label pane. Icons are
            required for this mode — without one, a collapsed item renders
            as an empty slot.
        -->
        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="LeftCompact"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Duplicates" Tag="Duplicates">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Copy"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Quality" Tag="Quality">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Filter"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Organization" Tag="Organization">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
