<Window
    x:Class="ImageCleanup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ImageCleanup">

    <!--
        Explicit Background is required here: an unpackaged WinUI 3 Window
        has no default page background of its own (no Mica/backdrop, no
        implicit fill) — without this the root Grid renders as whatever the
        composition swapchain's clear surface is, which happened to read as
        "fine" under Dark (looks close to black-on-black) but showed up as a
        broken grey smear under Light, since nothing was actually painting a
        light surface. ApplicationPageBackgroundThemeBrush is the standard
        WinUI token for "the app's base background" and flips correctly with
        RequestedTheme (see App.ApplyTheme).
    -->
    <Grid RowDefinitions="Auto,*"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!--
            ── Folder selection — shared across every page ──────────────────
            LayerFillColorDefaultBrush gives this shared toolbar a subtly
            distinct surface from the page content below (rather than every
            region collapsing onto the same flat background), consistent
            with the small set of elevation levels WinUI's theme resources
            provide (Layer < Card < page background).
        -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        Padding="16,16,16,8">
                <Button Content="Select Folder"
                        Click="OnSelectFolderClick"
                        IsEnabled="{x:Bind ScanSession.IsIdle, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind ScanSession.StatusText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"/>
            </StackPanel>
        </Border>

        <!--
            LeftCompact (not the previous "Left") is what gives the hamburger
            toggle its collapse/expand behavior: collapsed shows a slim
            icon-only pane (CompactPaneLength, ~48px — too narrow for label
            text, which is why "Left" was clipping labels instead of hiding
            them), toggled-open shows the full icon+label pane. Icons are
            required for this mode — without one, a collapsed item renders
            as an empty slot.
        -->
        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="LeftCompact"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Duplicates" Tag="Duplicates">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Copy"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Quality" Tag="Quality">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Filter"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Organization" Tag="Organization">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
